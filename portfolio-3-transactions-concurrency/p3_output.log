Demo trip 4932 (Lagos Jibowu → Abuja), second trip 4933 (Lagos Ojota → Ibadan)
Kemi Adebanjo = passenger 10003 at Terminal A, Tobi Nwachukwu = passenger 10004 at Terminal B, Halima Garba = passenger 10005
Everyone wants seat 12.

==========================================================================
  PART 1 — THE BUG: check-then-insert with no unique rule (booking_bug)
==========================================================================
A   > BEGIN
       BEGIN
A   > SELECT count(*) AS seat_12_holders FROM booking_bug WHERE trip_id = 4932 AND seat_number = 12
       seat_12_holders
       0
       (1 row)
B   > BEGIN
       BEGIN
B   > SELECT count(*) AS seat_12_holders FROM booking_bug WHERE trip_id = 4932 AND seat_number = 12
       seat_12_holders
       0
       (1 row)
A   > INSERT INTO booking_bug (trip_id, passenger_id, seat_number) VALUES (4932, 10003, 12)
       INSERT 0 1
A   > COMMIT
       COMMIT
B   > INSERT INTO booking_bug (trip_id, passenger_id, seat_number) VALUES (4932, 10004, 12)
       INSERT 0 1
B   > COMMIT
       COMMIT
A   > SELECT bug_id, passenger_id, seat_number FROM booking_bug WHERE trip_id = 4932 ORDER BY bug_id
       bug_id | passenger_id | seat_number
       1 | 10003 | 12
       2 | 10004 | 12
       (2 rows)
  >>> BUG: two passengers now hold the same seat.

==========================================================================
  PART 2 — FIX 1: a UNIQUE index on (trip_id, seat_number)
==========================================================================
A   > TRUNCATE booking_bug
       TRUNCATE TABLE
A   > CREATE UNIQUE INDEX booking_bug_seat_unique ON booking_bug (trip_id, seat_number)
       CREATE INDEX
A   > BEGIN
       BEGIN
A   > SELECT count(*) AS seat_12_holders FROM booking_bug WHERE trip_id = 4932 AND seat_number = 12
       seat_12_holders
       0
       (1 row)
B   > BEGIN
       BEGIN
B   > SELECT count(*) AS seat_12_holders FROM booking_bug WHERE trip_id = 4932 AND seat_number = 12
       seat_12_holders
       0
       (1 row)
A   > INSERT INTO booking_bug (trip_id, passenger_id, seat_number) VALUES (4932, 10003, 12)
       INSERT 0 1
B   > INSERT INTO booking_bug (trip_id, passenger_id, seat_number) VALUES (4932, 10004, 12)
B     ... still WAITING for a lock held by the other terminal
A   > COMMIT
       COMMIT
B     ... the waiting statement has now finished:
       ERROR [23505]: duplicate key value violates unique constraint "booking_bug_seat_unique"
       DETAIL: Key (trip_id, seat_number)=(4932, 12) already exists.
B   > ROLLBACK
       ROLLBACK
A   > SELECT bug_id, passenger_id, seat_number FROM booking_bug WHERE trip_id = 4932 ORDER BY bug_id
       bug_id | passenger_id | seat_number
       3 | 10003 | 12
       (1 row)
  >>> FIXED: B waited for A, then got a unique_violation. One holder only.

==========================================================================
  PART 3 — FIX 2: book_seat() locks the trip row (SELECT … FOR UPDATE)
==========================================================================
A   > BEGIN
       BEGIN
A   > SELECT book_seat(4932, 10003, 12, 23500.00, 'CARD') AS booking_id
       booking_id
       180018
       (1 row)
B   > BEGIN
       BEGIN
B   > SELECT book_seat(4932, 10004, 12, 23500.00, 'CARD') AS booking_id
B     ... still WAITING for a lock held by the other terminal
A   > COMMIT
       COMMIT
B     ... the waiting statement has now finished:
       ERROR [23505]: Seat 12 on trip 4932 is already booked
B   > ROLLBACK
       ROLLBACK
A   > SELECT booking_id, passenger_id, seat_number, status FROM booking WHERE trip_id = 4932 AND seat_number = 12 AND status = 'CONFIRMED'
       booking_id | passenger_id | seat_number | status
       180018 | 10003 | 12 | CONFIRMED
       (1 row)
  >>> FIXED: B queued behind A's lock, then got a clear 'already booked' message.

==========================================================================
  PART 4 — FIX 3: SERIALIZABLE stops the bug even with NO unique index
==========================================================================
A   > DROP INDEX booking_bug_seat_unique
       DROP INDEX
A   > TRUNCATE booking_bug
       TRUNCATE TABLE
A   > BEGIN ISOLATION LEVEL SERIALIZABLE
       BEGIN
A   > SELECT count(*) AS seat_12_holders FROM booking_bug WHERE trip_id = 4932 AND seat_number = 12
       seat_12_holders
       0
       (1 row)
B   > BEGIN ISOLATION LEVEL SERIALIZABLE
       BEGIN
B   > SELECT count(*) AS seat_12_holders FROM booking_bug WHERE trip_id = 4932 AND seat_number = 12
       seat_12_holders
       0
       (1 row)
A   > INSERT INTO booking_bug (trip_id, passenger_id, seat_number) VALUES (4932, 10003, 12)
       INSERT 0 1
B   > INSERT INTO booking_bug (trip_id, passenger_id, seat_number) VALUES (4932, 10004, 12)
       INSERT 0 1
A   > COMMIT
       COMMIT
B   > COMMIT
       ERROR [40001]: could not serialize access due to read/write dependencies among transactions
       DETAIL: Reason code: Canceled on identification as a pivot, during commit attempt.
A   > SELECT bug_id, passenger_id, seat_number FROM booking_bug WHERE trip_id = 4932 ORDER BY bug_id
       bug_id | passenger_id | seat_number
       5 | 10003 | 12
       (1 row)
  >>> FIXED: PostgreSQL saw that both read 'seat free' and both wrote it,
      so it cancelled B with a serialization failure (SQLSTATE 40001).

==========================================================================
  PART 5 — READ COMMITTED vs REPEATABLE READ (counting booked seats)
==========================================================================
-- 5a: READ COMMITTED (the default)
A   > BEGIN ISOLATION LEVEL READ COMMITTED
       BEGIN
A   > SELECT count(*) AS seats_booked FROM booking WHERE trip_id = 4932 AND status = 'CONFIRMED'
       seats_booked
       1
       (1 row)
B   > SELECT book_seat(4932, 10004, 13, 23500.00, 'CARD') AS booking_id
       booking_id
       180019
       (1 row)
A   > SELECT count(*) AS seats_booked FROM booking WHERE trip_id = 4932 AND status = 'CONFIRMED'
       seats_booked
       2
       (1 row)
A   > COMMIT
       COMMIT
  >>> A saw the count change inside ONE transaction (non-repeatable read).
-- 5b: REPEATABLE READ
A   > BEGIN ISOLATION LEVEL REPEATABLE READ
       BEGIN
A   > SELECT count(*) AS seats_booked FROM booking WHERE trip_id = 4932 AND status = 'CONFIRMED'
       seats_booked
       2
       (1 row)
B   > SELECT book_seat(4932, 10005, 14, 23500.00, 'CARD') AS booking_id
       booking_id
       180020
       (1 row)
A   > SELECT count(*) AS seats_booked FROM booking WHERE trip_id = 4932 AND status = 'CONFIRMED'
       seats_booked
       2
       (1 row)
A   > COMMIT
       COMMIT
A   > SELECT count(*) AS seats_booked FROM booking WHERE trip_id = 4932 AND status = 'CONFIRMED'
       seats_booked
       3
       (1 row)
  >>> A kept its snapshot until COMMIT; the new booking appears afterwards.

==========================================================================
  PART 6 — DEADLOCK: two desks lock the two trips in opposite order
==========================================================================
A   > BEGIN
       BEGIN
A   > SELECT trip_id FROM trip WHERE trip_id = 4932 FOR UPDATE
       trip_id
       4932
       (1 row)
B   > BEGIN
       BEGIN
B   > SELECT trip_id FROM trip WHERE trip_id = 4933 FOR UPDATE
       trip_id
       4933
       (1 row)
A   > SELECT trip_id FROM trip WHERE trip_id = 4933 FOR UPDATE
A     ... still WAITING for a lock held by the other terminal
B   > SELECT trip_id FROM trip WHERE trip_id = 4932 FOR UPDATE
       ERROR [40P01]: deadlock detected
       DETAIL: Process 19116 waits for ShareLock on transaction 947; blocked by process 19115.
       DETAIL: Process 19115 waits for ShareLock on transaction 948; blocked by process 19116.
A     ... the waiting statement has now finished:
       trip_id
       4933
       (1 row)
A   > ROLLBACK
       ROLLBACK
B   > ROLLBACK
       ROLLBACK
  >>> PostgreSQL detected the cycle after deadlock_timeout (1s) and
      aborted one transaction (SQLSTATE 40P01) so the other could go on.
-- 6b: the fix — always lock trips in trip_id order
A   > BEGIN
       BEGIN
A   > SELECT trip_id FROM trip WHERE trip_id IN (4932, 4933) ORDER BY trip_id FOR UPDATE
       trip_id
       4932
       4933
       (2 rows)
B   > BEGIN
       BEGIN
B   > SELECT trip_id FROM trip WHERE trip_id IN (4932, 4933) ORDER BY trip_id FOR UPDATE
B     ... still WAITING for a lock held by the other terminal
A   > COMMIT
       COMMIT
B     ... the waiting statement has now finished:
       trip_id
       4932
       4933
       (2 rows)
B   > COMMIT
       COMMIT
  >>> Same two locks, same order: B simply waits its turn. No deadlock.

